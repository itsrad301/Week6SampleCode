@model ProductViewModel

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h1 class="card-title mb-0">Create Product</h1>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Create" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Please fix the following errors:</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryID" class="form-label fw-semibold"></label>
                            <select asp-for="CategoryID" class="form-select form-select-lg" asp-items="ViewBag.Categories"></select>
                            <div class="invalid-feedback d-block">
                                <span asp-validation-for="CategoryID" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SupplierID" class="form-label fw-semibold"></label>
                            <select asp-for="SupplierID" class="form-select form-select-lg" asp-items="ViewBag.Suppliers"></select>
                            <div class="invalid-feedback d-block">
                                <span asp-validation-for="SupplierID" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control form-control-lg" rows="4" placeholder="Enter product description"></textarea>
                            <div class="form-text">Maximum 500 characters</div>
                            <div class="invalid-feedback d-block">
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UnitPrice" class="form-label fw-semibold"></label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="UnitPrice" class="form-control" placeholder="0.00" step="0.01" />
                                </div>
                                <div class="invalid-feedback d-block">
                                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="QuantityInStock" class="form-label fw-semibold"></label>
                                <input asp-for="QuantityInStock" class="form-control form-control-lg" type="number" />
                                <div class="invalid-feedback d-block">
                                    <span asp-validation-for="QuantityInStock" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="dateFirstIssued" class="form-label fw-semibold"></label>
                            <input asp-for="dateFirstIssued" class="form-control form-control-lg" type="date" />
                            <div class="invalid-feedback d-block">
                                <span asp-validation-for="dateFirstIssued" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="bi bi-plus-circle"></i> Create Product
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Bootstrap form validation
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.querySelectorAll('form[novalidate]');
                Array.prototype.slice.call(forms).forEach(function(form) {
                    form.addEventListener('submit', function(event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            });
        })();
    </script>
}
